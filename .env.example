# Шаблон настроек. Скопируй его в .env и заполни пароли:
#     cp .env.example .env
# .env в git не попадает, а этот файл попадает, поэтому паролей здесь нет.
# Формат: ИМЯ=значение, без пробелов вокруг "=" и без кавычек.

# --- Адреса сервисов для локального кода (из WSL) ---
KAFKA_BOOTSTRAP=localhost:9094
S3_ENDPOINT=http://localhost:9000
CH_HOST=localhost
CH_PORT=8123

# --- S3-хранилище (RustFS). Не используй стандартное значение rustfsadmin.
# Пароль не короче 8 символов
S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=

# --- ClickHouse ---
CLICKHOUSE_DB=pipeline
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=